{
  "name": "mailpouch",
  "version": "3.0.77",
  "description": "mailpouch — MCP server that exposes Proton Mail via Proton Bridge. 70 tools, Resources, and Prompts for agentic email management with user-initiated permission controls.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mailpouch": "dist/index.js",
    "mailpouch-settings": "dist/settings-main.js"
  },
  "scripts": {
    "build": "tsc",
    "settings": "node dist/settings-main.js",
    "build:clean": "npm run clean && npm run build",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run --exclude test/agent-harness.test.ts",
    "test:watch": "vitest --exclude test/agent-harness.test.ts",
    "test:coverage": "vitest run --coverage --exclude test/agent-harness.test.ts",
    "test:harness": "vitest run test/agent-harness.test.ts --reporter=verbose --testTimeout=30000",
    "test:e2e:local": "docker compose -f test/e2e/fixtures/greenmail-compose.yml up -d && node scripts/wait-for-port.mjs 127.0.0.1 3143 30 && vitest run --config vitest.config.e2e.ts; r=$?; docker compose -f test/e2e/fixtures/greenmail-compose.yml down; exit $r",
    "test:e2e:local:keep": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:bridge": "vitest run --config vitest.config.e2e.ts --reporter=verbose --testTimeout=60000",
    "test:e2e:bridge:safe": "MAILPOUCH_E2E_SAFE=1 vitest run --config vitest.config.e2e.ts test/e2e/scenarios/safe-bridge.e2e.test.ts --reporter=verbose --testTimeout=60000",
    "test:e2e:bridge:cleanup": "node test/e2e/support/cleanup-bridge.mjs",
    "check:version-sync": "node scripts/check-version-sync.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:npm-audit": "node scripts/check-npm-audit.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:tarball": "node scripts/smoke-tarball.mjs",
    "check:bulk:live": "node scripts/check-bulk-live.mjs",
    "preship:fast": "node scripts/preship.mjs fast",
    "preship": "node scripts/preship.mjs",
    "preship:release": "node scripts/preship.mjs release",
    "prepare": "npm run build",
    "postinstall": "node scripts/install-hooks.mjs",
    "prepublishOnly": "npm run preship:release",
    "lint": "tsc --noEmit",
    "lint:fix": "tsc --noEmit",
    "clean": "node -e \"for(const d of ['dist','coverage'])require('fs').rmSync(d,{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mailpouch",
    "proton-bridge",
    "proton-mail",
    "mcp",
    "model-context-protocol",
    "email",
    "email-management",
    "automation",
    "typescript",
    "claude",
    "claude-desktop",
    "ai",
    "productivity",
    "bridge",
    "smtp",
    "imap",
    "analytics",
    "email-analytics",
    "email-automation"
  ],
  "author": {
    "name": "Charles Handshy",
    "email": "chandshy@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/chandshy/mailpouch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chandshy/mailpouch.git"
  },
  "bugs": {
    "url": "https://github.com/chandshy/mailpouch/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.29.0",
    "better-sqlite3": "^12.9.0",
    "imapflow": "~1.4.3",
    "mailparser": "~3.9.8",
    "nodemailer": "~8.0.7"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "~1.3.0",
    "systray2": "~2.1.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "simple-git-hooks": {
    "pre-push": "npm run preship:fast"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "README.md",
    "README_FIRST_AI.md",
    "HELP.md",
    "llms.txt",
    "LICENSE",
    "CHANGELOG.md",
    "docs/**/*.md",
    "package.json",
    "native/tray/index.js",
    "native/tray/index.d.ts",
    "native/tray/*.node",
    "scripts/install-hooks.mjs"
  ],
  "overrides": {
    "hono": ">=4.12.14",
    "@hono/node-server": ">=1.19.13",
    "path-to-regexp": ">=8.4.2",
    "fast-uri": ">=3.1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
